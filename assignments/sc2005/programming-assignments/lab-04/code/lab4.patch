@@ -67,6 +67,36 @@ usertrap(void)
     syscall();
   } else if((which_dev = devintr()) != 0){
     // ok
+  } else if(r_scause() == 13 || r_scause() == 15){
+    uint64 addr = r_stval();
+
+    if(addr < p->heap_start || addr >= p->sz || addr >= TRAPFRAME){
+      setkilled(p);
+    } else {
+      uint64 va = PGROUNDDOWN(addr);
+      pte_t *pte = walk(p->pagetable, va, 0);
+
+      if(pte != 0 && (*pte & PTE_V)){
+        setkilled(p);
+      } else {
+        char *mem = kalloc();
+
+        if(mem == 0){
+          setkilled(p);
+        } else {
+          memset(mem, 0, PGSIZE);
+
+          if(mappages(p->pagetable, va, PGSIZE, (uint64)mem, PTE_R | PTE_W | PTE_U) != 0){
+            kfree(mem);
+            setkilled(p);
+          }
+        }
+      }
+    }
+
+    if(killed(p)){
+      printf("page fault: pid=%d cause=%d va=%p\n", p->pid, (int)r_scause(), (void *)addr);
+    }
   } else {
     printf("usertrap(): unexpected scause 0x%lx pid=%d\n", r_scause(), p->pid);
     printf("            sepc=0x%lx stval=0x%lx\n", r_sepc(), r_stval());
