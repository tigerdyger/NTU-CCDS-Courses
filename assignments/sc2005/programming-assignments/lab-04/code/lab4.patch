 uint64
 sys_sbrk(void)
 {
-  uint64 addr;
   int n;
+  struct proc *p = myproc();
+  uint64 addr = p->sz;
 
   argint(0, &n);
-  addr = myproc()->sz;
-  if(growproc(n) < 0)
-    return -1;
+
+  if(n > 0){
+    uint64 newsz = addr + (uint64)n;
+    if(newsz < addr || newsz >= TRAPFRAME)
+      return -1;
+
+    p->sz = newsz;
+  } else if(n < 0){
+    uint64 shrink = (uint64)(-(long)n);
+    if(addr < p->heap_start ||
+       shrink > addr - p->heap_start)
+      return -1;
+
+    p->sz = uvmdealloc(p->pagetable, addr, addr - shrink);
+  }
+
   return addr;
 }
 
@@ -91,3 +105,27 @@ sys_uptime(void)
   release(&tickslock);
   return xticks;
 }
+
+uint64
+sys_countvp(void)
+{
+  struct proc *p = myproc();
+  return PGROUNDUP(p->sz) / PGSIZE;
+}
+
+uint64
+sys_countpp(void)
+{
+  struct proc *p = myproc();
+  int count = 0;
+
+  for(uint64 va = 0; va < p->sz; va += PGSIZE){
+    pte_t *pte = walk(p->pagetable, va, 0);
+
+    if(pte != 0 && (*pte & PTE_V) && (*pte & (PTE_R | PTE_W | PTE_X))){
+      count++;
+    }
+  }
+
+  return count;
+}
diff --git a/kernel/trap.c b/kernel/trap.c
